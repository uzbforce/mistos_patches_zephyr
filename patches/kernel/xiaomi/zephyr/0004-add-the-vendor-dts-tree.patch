+		resets = <&gcc GCC_USB3_PHY_PRIM_SP0_BCR>,
+			<&gcc GCC_USB3PHY_PHY_PRIM_SP0_BCR>;
+		reset-names = "phy_reset", "phy_phy_reset";
+	};
