+#include "kalamap-aim300.dtsi"
+
+&tlmm {
+	pice1_usb_hub_3p3_default: pice1_usb_hub_3p3_default {
+		mux {
+			pins = "gpio178";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio178";
+			drive-strength = <2>;
+			output-high;
+			bias-pull-up;
+		};
+	};
+
+	pice1_hub_ponrst_default: pice1_hub_ponrst_default {
+		mux {
+			pins = "gpio72";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio72";
+			drive-strength = <2>;
+			output-high;
+			bias-pull-up;
+		};
+	};
+
+	fan_pwr_en_gpio_default: fan_pwr_en_gpio_default {
+		mux {
+			pins = "gpio154";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio154";
+			drive-strength = <2>;
+			output-low;
+			bias-disable;
+		};
+	};
+};
+
+&soc {
+	/* remove the node, use upd verg instead */
+	/delete-node/ qps615_bridge_0p9_vreg;
