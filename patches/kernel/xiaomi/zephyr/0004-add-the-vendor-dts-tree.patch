+			size-min = <0x0 0x4800000>;    /* 72 MB */
+		};
+
+		vcpus {
+			affinity = "static";
+			affinity-map = <0x6>;
+		};
+
+		vdevices {
+			virtio-mmio@0 {
+				dma_base = <0x0 0x0>;
+				memory {
+					qcom,label = <0x13>;
+					#address-cells = <0x2>;
