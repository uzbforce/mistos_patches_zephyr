diff --git a/arch/arm64/boot/dts/vendor/bindings/thermal/qti-lmh-cpu-vdd-cdev.txt b/arch/arm64/boot/dts/vendor/bindings/thermal/qti-lmh-cpu-vdd-cdev.txt
