+		clock-names = "uart", "clk_uart_baud0";
+		pinctrl-names = "default";
+		pinctrl-0 = <&uart0_bus>;
+	};
diff --git a/arch/arm64/boot/dts/vendor/bindings/clock/exynos7-clock.txt b/arch/arm64/boot/dts/vendor/bindings/clock/exynos7-clock.txt
