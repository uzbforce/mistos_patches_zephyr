+
+				config {
+					pins = "gpio17", "gpio18",
+						"gpio19", "gpio20";
+					drive-strength = <2>;
+					bias-disable;
+				};
+			};
+		};
+
+		blsp1_uart4 {
+			blsp1_uart4_tx_active: blsp1_uart4_tx_active {
+				mux {
+					pins = "gpio82";
+					function = "blsp_uart3";
