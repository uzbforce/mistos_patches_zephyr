+			reg = <0xfee03b 2>, <0xfee045 2>;
+		};
diff --git a/arch/arm64/boot/dts/vendor/bindings/clock/renesas,r9a06g032-sysctrl.yaml b/arch/arm64/boot/dts/vendor/bindings/clock/renesas,r9a06g032-sysctrl.yaml
new file mode 100644
index 000000000..25dbb0fac
--- /dev/null
+++ b/arch/arm64/boot/dts/vendor/bindings/clock/renesas,r9a06g032-sysctrl.yaml
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/renesas,r9a06g032-sysctrl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Renesas RZ/N1D (R9A06G032) System Controller
+
+maintainers:
+  - Gareth Williams <gareth.williams.jx@renesas.com>
+  - Geert Uytterhoeven <geert+renesas@glider.be>
+
+properties:
+  compatible:
+    const: renesas,r9a06g032-sysctrl
+
