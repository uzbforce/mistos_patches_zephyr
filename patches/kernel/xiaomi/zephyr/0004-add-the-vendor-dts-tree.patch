+				config {
+					pins = "gpio17", "gpio18",
+						"gpio19", "gpio20";
+					drive-strength = <2>;
+					bias-disable;
+				};
+			};
+
+			blsp1_uart3_sleep: blsp1_uart3_sleep {
+				mux {
+					pins = "gpio17", "gpio18",
+						"gpio19", "gpio20";
+					function = "gpio";
