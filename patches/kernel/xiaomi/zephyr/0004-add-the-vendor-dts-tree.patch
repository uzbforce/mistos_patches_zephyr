+		gpio = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&qps615_bridge0_0p9_vreg>;
+		regulator-min-microvolt = <1000000>;
+		regulator-max-microvolt = <1000000>;
