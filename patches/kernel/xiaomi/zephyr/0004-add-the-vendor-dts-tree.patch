+		qcom,pre-scaling = <1 1>;
+	};
+
+	amux_therm1 {
+		reg = <ADC5_AMUX_THM1_100K_PU>;
+		label = "amux_therm1";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <1>;
+		qcom,pre-scaling = <1 1>;
+	};
+};
+
+&pm8150_adc_tm {
+	xo_therm {
+		reg = <0>;
+		io-channels = <&pm8150_vadc ADC5_XO_THERM_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <1>;
+	};
+
+	amux_therm1 {
+		reg = <1>;
+		io-channels = <&pm8150_vadc ADC5_AMUX_THM1_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <1>;
+	};
