+      #interrupt-cells = <1>;
+
+      interrupt-parent = <&cpuintc>;
+      interrupts = <2>;
+    };
diff --git a/arch/arm64/boot/dts/vendor/bindings/interrupt-controller/intel,ce4100-ioapic.txt b/arch/arm64/boot/dts/vendor/bindings/interrupt-controller/intel,ce4100-ioapic.txt
