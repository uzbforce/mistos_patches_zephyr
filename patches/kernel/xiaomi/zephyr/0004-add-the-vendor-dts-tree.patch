+			};
+		};
+
+		qupv3_se0_4uart_pins: qupv3_se0_4uart_pins {
+			qupv3_se0_default_ctsrtsrx:
+				qupv3_se0_default_ctsrtsrx {
+				mux {
+					pins = "gpio0", "gpio1", "gpio3";
+					function = "gpio";
+				};
+
+				config {
+					pins = "gpio0", "gpio1", "gpio3";
+					drive-strength = <2>;
