diff --git a/arch/arm64/boot/dts/vendor/bindings/serial/qca,ar9330-uart.yaml b/arch/arm64/boot/dts/vendor/bindings/serial/qca,ar9330-uart.yaml
new file mode 100644
index 000000000..a644e5af1
--- /dev/null
+++ b/arch/arm64/boot/dts/vendor/bindings/serial/qca,ar9330-uart.yaml
