diff --git a/arch/arm64/boot/dts/vendor/bindings/input/touchscreen/auo_pixcir_ts.txt b/arch/arm64/boot/dts/vendor/bindings/input/touchscreen/auo_pixcir_ts.txt
new file mode 100644
