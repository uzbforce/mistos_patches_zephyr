--- /dev/null
+++ b/arch/arm64/boot/dts/vendor/bindings/extcon/extcon-lt8711uxe2.txt
@@ -0,0 +1,37 @@
+LT8711UXE2 Extcon device
+
+Required properties:
+- compatible: Should be "lt,lt8711uxe2"
+- reg: Main I2C slave ID (for I2C host driver)
+- interrupt-parent: the phandle for the gpio controller
+- interrupts: description of interrupt line
+- lt,irq-gpio: Main IRQ gpio mapping
+- lt,dp-lane-sel: Main DP lane mapping
+- lt,dp-alt-en: Main DP alt mapping
+- lt,reset-gpio: Main reset gpio mapping
+- lt,cc-gpio: use the GPIO signal from KTM5030 to determine CC communication
+- pinctrl-names: the pin control state names; should contain "default"
+- pinctrl-0: List of phandles to configure the GPIO pin used as interrupt line
+
+Example:
+
+&qupv3_hub_i2c3 {
+	status = "ok";
+	extcon_lt8711uxe2: lt8711uxe2@3f {
+		compatible = "lt,lt8711uxe2";
+		reg = <0x3f>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <31 IRQ_TYPE_LEVEL_HIGH>;
+		lt,irq-gpio = <&tlmm 31 0>;
+		lt,dp-lane-sel = <&tlmm 50 0>;
+		lt,dp-alt-en = <&tlmm 51 0>;
+		lt,reset-gpio = <&tlmm 46 0>;
+		lt.cc-gpio = <&tlmm 18 0>;
+		usb-ss-support;
+		pinctrl-names = "default";
+		pinctrl-0 = <&lt8711uxe2_int &lt8711uxe2_dp_alt_en
+			&lt8711uxe2_dp_lane_sel &lt8711uxe2_rst>;
+		img-fw-rev = <0x000004>;
+		status = "okay";
+	};
+};
diff --git a/arch/arm64/boot/dts/vendor/bindings/extcon/extcon-max3355.txt b/arch/arm64/boot/dts/vendor/bindings/extcon/extcon-max3355.txt
new file mode 100644
index 000000000..f2288ea9e
--- /dev/null
+++ b/arch/arm64/boot/dts/vendor/bindings/extcon/extcon-max3355.txt
@@ -0,0 +1,21 @@
+Maxim Integrated MAX3355 USB OTG chip
+-------------------------------------
+
+MAX3355 integrates a charge pump and comparators to enable a system with an
+integrated USB OTG dual-role transceiver to function as a USB OTG dual-role
+device.
+
+Required properties:
+- compatible: should be "maxim,max3355";
+- maxim,shdn-gpios: should contain a phandle and GPIO specifier for the GPIO pin
+		    connected to the MAX3355's SHDN# pin;
+- id-gpios: should contain a phandle and GPIO specifier for the GPIO pin
+	    connected to the MAX3355's ID_OUT pin.
+
+Example:
+
+	usb-otg {
+		compatible = "maxim,max3355";
+		maxim,shdn-gpios = <&gpio2 4 GPIO_ACTIVE_LOW>;
+		id-gpios = <&gpio5 31 GPIO_ACTIVE_HIGH>;
+	};
diff --git a/arch/arm64/boot/dts/vendor/bindings/extcon/extcon-palmas.txt b/arch/arm64/boot/dts/vendor/bindings/extcon/extcon-palmas.txt
