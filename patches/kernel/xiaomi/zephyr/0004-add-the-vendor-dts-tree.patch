+
+    reset-controller@30390000 {
+        compatible = "fsl,imx7d-src", "syscon";
+        reg = <0x30390000 0x2000>;
+        interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
+        #reset-cells = <1>;
+    };
diff --git a/arch/arm64/boot/dts/vendor/bindings/reset/hisilicon,hi3660-reset.yaml b/arch/arm64/boot/dts/vendor/bindings/reset/hisilicon,hi3660-reset.yaml
