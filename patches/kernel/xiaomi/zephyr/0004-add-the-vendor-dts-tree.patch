+            reg = <0>;
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            regulator@0 {
+                compatible = "google,cros-ec-regulator";
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <3300000>;
+                reg = <0>;
+            };
+        };
+    };
+...
diff --git a/arch/arm64/boot/dts/vendor/bindings/regulator/hisilicon,hi655x-regulator.txt b/arch/arm64/boot/dts/vendor/bindings/regulator/hisilicon,hi655x-regulator.txt
