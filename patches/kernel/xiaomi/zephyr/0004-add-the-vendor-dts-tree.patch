+			mux {
+				pins = "gpio4";
+				function = "i2chub0_se4_l0";
+			};
+
+			config {
+				pins = "gpio4";
+				drive-strength = <8>;
+				bias-disable;
+			};
+		};
+
+		i2chub0_se4_scl_active: i2chub0_se4_scl_active {
+			mux {
+				pins = "gpio5";
+				function = "i2chub0_se4_l1";
+			};
+
+			config {
+				pins = "gpio5";
+				drive-strength = <8>;
+				bias-disable;
+			};
+		};
+
+		i2chub0_se4_sleep: i2chub0_se4_sleep {
+			mux {
+				pins = "gpio4", "gpio5";
+				function = "gpio";
+			};
+
+			config {
+				pins = "gpio4", "gpio5";
+				drive-strength = <2>;
+			};
+		};
+	};
