diff --git a/arch/arm64/boot/dts/vendor/bindings/ipmi/aspeed,ast2400-ibt-bmc.txt b/arch/arm64/boot/dts/vendor/bindings/ipmi/aspeed,ast2400-ibt-bmc.txt
