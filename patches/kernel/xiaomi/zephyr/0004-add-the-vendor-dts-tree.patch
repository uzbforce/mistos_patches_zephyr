+      qcom,max-current-ma:
+        description: Maximum current allowed for indicator LED device.
+          Unit is mA.
+        allOf:
+          - $ref: /schemas/types.yaml#/definitions/uint32
+        minimum: 0
+        maximum: 100
+
+      qcom,ires-ua:
+        description: Current resolution for indicator LED device. Unit is uA.
+        allOf:
+          - $ref: /schemas/types.yaml#/definitions/uint32
+        items:
+          - const: 5000
+
+    required:
+      - label
+      - qcom,led-name
+      - qcom,id
