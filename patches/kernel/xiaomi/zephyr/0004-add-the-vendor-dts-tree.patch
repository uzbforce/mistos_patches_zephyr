+				};
+			};
+
+			swiotlb-shm {
+				dma_base = <0x0 0x4000>;
+				memory {
+					qcom,label = <0x14>;
+					#address-cells = <0x2>;
+					base = <0x0 0xFFF00000>;
+				};
+			};
+
+
+			/delete-node/ vsock-msgq;
+
+			vcpu-sched-test-msgq {
+				qcom,label = <0x9>;
+			};
+		};
+	};
+};
+
+&soc {
+	qtee_shmbridge {
+		qcom,custom-bridge-size = <512>;
+	};
+
+	/delete-node/ vsock-gunyah;
+};
