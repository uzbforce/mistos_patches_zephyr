+				drive-strength = <2>;	/* 2 MA */
+			};
+
+			sd-cd {
+				pins = "gpio88";
+				bias-disable;
+				drive-strength = <2>;
+			};
+		};
+
+		/* WSA speaker reset pin1 */
+		spkr_1_sd_n {
+			spkr_1_sd_n_sleep: spkr_1_sd_n_sleep {
+				mux {
+					pins = "gpio106";
+					function = "gpio";
+				};
+
+				config {
