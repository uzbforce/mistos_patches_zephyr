+	sensor groups like clearing min/max, enabling/disabling sensor
+	group.
diff --git a/arch/arm64/boot/dts/vendor/bindings/pps/pps-gpio.txt b/arch/arm64/boot/dts/vendor/bindings/pps/pps-gpio.txt
