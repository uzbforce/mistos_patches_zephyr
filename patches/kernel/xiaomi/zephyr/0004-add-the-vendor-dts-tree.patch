index 000000000..a616e302c
--- /dev/null
+++ b/arch/arm64/boot/dts/vendor/qcom/waipio.dtsi
@@ -0,0 +1,3700 @@
+#include <dt-bindings/clock/qcom,aop-qmp.h>
