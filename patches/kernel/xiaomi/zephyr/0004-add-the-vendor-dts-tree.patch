+
+&cdsp_mem {
+	reg = <0x0 0x9d200000 0x0 0x2000000>;
+};
+
+&q6_cdsp_dtb_mem {
+	reg = <0x0 0x9f200000 0x0 0x80000>;
+};
+
+&q6_adsp_dtb_mem {
