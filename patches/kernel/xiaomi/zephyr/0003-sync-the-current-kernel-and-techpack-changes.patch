+static int dsi_display_get_clocks_count(struct dsi_display *display,
+						char *dsi_clk_name)
+{
+	if (display->fw)
+		return dsi_parser_count_strings(display->parser_node,
+			dsi_clk_name);
+	else
+		return of_property_count_strings(display->panel_node,
+			dsi_clk_name);
