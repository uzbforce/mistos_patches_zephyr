+u8 bl_payload[3] = {0x51, 0x00, 0x08};
+u8 F4_payload[2] = {0xF4, 0x13};
+
+static int dsi_panel_update_bl_payload(struct dsi_panel *panel,
+	u16 bl_lvl, u32 cur_bl)
+{
+	struct dsi_panel_cmd_set *set;
+	struct dsi_display_mode *mode = panel->cur_mode;
+	struct dsi_display_mode_priv_info *prv_info =  mode->priv_info;
+
+	set = &prv_info->cmd_sets[DSI_CMD_SET_MI_HBM_ON_L1];
+	bl_payload[1] =  bl_lvl & 0xff;
+	bl_payload[2] =  bl_lvl>> 8;
+	if(cur_bl >=0 && cur_bl <= 2047){
+        F4_payload[1] = 0x13;
+    }
+	if(cur_bl >=2048 && cur_bl <= 2303){
+		F4_payload[1] = 0x0C;
+	}
+	if(cur_bl >=2304 && cur_bl <= 2559){
+		F4_payload[1] = 0x0D;
+	}
+	if(cur_bl >=2560 && cur_bl <= 2815){
+		F4_payload[1] = 0x0E;
+	}
+	if(cur_bl >=2816 && cur_bl <= 3071){
+		F4_payload[1] = 0x0F;
+	}
+	if(cur_bl >=3072 && cur_bl <= 3327){
+		F4_payload[1] = 0x10;
+	}
+	if(cur_bl >=3328 && cur_bl <= 3583){
+		F4_payload[1] = 0x11;
+	}
+	if(cur_bl >=3584 && cur_bl <= 3839){
+		F4_payload[1] = 0x12;
+	}
+	if(cur_bl >=3840 && cur_bl <= 4095){
+		F4_payload[1] = 0x13;
+	}
+	set->cmds[2].msg.tx_buf =  (const void *)bl_payload;
+	set->cmds[4].msg.tx_buf =  (const void *)F4_payload;
+	DSI_INFO("payloader 51reg = [%d], value1[%d], value2[%d], f4reg = [%d], value1 = [%d]\n",
+		(int)(((u8 *)set->cmds[2].msg.tx_buf)[0]), (int)(((u8 *)set->cmds[2].msg.tx_buf)[1]), (int)(((u8 *)set->cmds[2].msg.tx_buf)[2]),
+		(int)(((u8 *)set->cmds[4].msg.tx_buf)[0]), (int)(((u8 *)set->cmds[4].msg.tx_buf)[1]));
+	return 0;
+}
+// 1: need update
+static int judge_to_update_bl_payload(u32 cur_lvl, u32 last_bl)
+{
+	if (cur_lvl >= 0 && cur_lvl <= 2047)
+	{
+		if (last_bl >= 0 && last_bl <= 2047)
+			return 0;
+		return 1;
+	}
+	if(cur_lvl >=2048 && cur_lvl <= 2303){
+		if (last_bl >= 2048 && last_bl <= 2303)
+			return 0;
+		return 1;
+	}
+	if(cur_lvl >=2304 && cur_lvl <= 2559){
+		if (last_bl >= 2304 && last_bl <= 2559)
+			return 0;
+		return 1;
+	}
+	if(cur_lvl >=2560 && cur_lvl <= 2815){
+		if (last_bl >= 2560 && last_bl <= 2815)
+			return 0;
+		return 1;
+	}
+	if(cur_lvl >=2816 && cur_lvl <= 3071){
+		if (last_bl >= 2816 && last_bl <= 3071)
+			return 0;
+		return 1;
+	}
+	if(cur_lvl >=3072 && cur_lvl <= 3327){
+		if (last_bl >= 3072 && last_bl <= 3327)
+			return 0;
+		return 1;
+	}
+	if(cur_lvl >=3328 && cur_lvl <= 3583){
+		if (last_bl >= 3328 && last_bl <= 3583)
+			return 0;
+		return 1;
+	}
+	if(cur_lvl >=3584 && cur_lvl <= 3839){
+		if (last_bl >= 3584 && last_bl <= 3839)
+			return 0;
+		return 1;
+	}
+	if(cur_lvl >=3840 && cur_lvl <= 4095){
+		if (last_bl >= 3840 && last_bl <= 4095)
+			return 0;
+		return 1;
+	}
+	return 0;
+}
+static u32 last_bl = 0;
+
+#ifdef MI_DISPLAY_MODIFY
+int dsi_panel_update_backlight(struct dsi_panel *panel,
+	u32 bl_lvl)
+#else
+static int dsi_panel_update_backlight(struct dsi_panel *panel,
+	u32 bl_lvl)
+#endif
+{
+	int rc = 0;
+	u32 cur_bl;
+	unsigned long mode_flags = 0;
+
+#ifdef MI_DISPLAY_MODIFY
+	const int disp_id = MI_DISP_PRIMARY;
+#endif
+	struct mipi_dsi_device *dsi = NULL;
+	cur_bl = bl_lvl;
+
+	if (!panel || (bl_lvl > 0xffff)) {
+		DSI_ERR("invalid params\n");
+		return -EINVAL;
+	}
+
+	DSI_INFO("%s: %d\n", __func__, bl_lvl);
+
+	dsi = &panel->mipi_device;
+	if (unlikely(panel->bl_config.lp_mode)) {
+		mode_flags = dsi->mode_flags;
+		dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	}
+
+#ifdef MI_DISPLAY_MODIFY
+	mi_disp_feature_event_notify_by_type(disp_id, MI_DISP_EVENT_BACKLIGHT,
+						sizeof(bl_lvl), bl_lvl);
+#endif
+
+	if (panel->bl_config.bl_inverted_dbv)
+		bl_lvl = (((bl_lvl & 0xff) << 8) | (bl_lvl >> 8));
+
+	if (judge_to_update_bl_payload(cur_bl, last_bl)) {
+		if (cur_bl)
+			rc = dsi_panel_tx_cmd_set(panel, DSI_CMD_SET_MI_DIMMINGOFF);
+		dsi_panel_update_bl_payload(panel, bl_lvl, cur_bl);
+		rc = dsi_panel_tx_cmd_set(panel, DSI_CMD_SET_MI_HBM_ON_L1);
+		if (cur_bl)
+			rc = dsi_panel_tx_cmd_set(panel, DSI_CMD_SET_MI_DIMMINGON);
+		DSI_INFO("set bl lvl:%d rc:%d\n", bl_lvl, rc);
+	} else {
+		rc = mipi_dsi_dcs_set_display_brightness(dsi, bl_lvl);
+		if (rc < 0)
+			DSI_ERR("failed to update dcs backlight:%d\n", bl_lvl);
+	}
+	last_bl = cur_bl;
+
+	if (unlikely(panel->bl_config.lp_mode))
+		dsi->mode_flags = mode_flags;
+
+	return rc;
+}
+
+static int dsi_panel_update_pwm_backlight(struct dsi_panel *panel,
+	u32 bl_lvl)
+{
+	int rc = 0;
+	u32 duty = 0;
+	u32 period_ns = 0;
+	struct dsi_backlight_config *bl;
+
+	if (!panel) {
+		DSI_ERR("Invalid Params\n");
+		return -EINVAL;
+	}
+
+	bl = &panel->bl_config;
+	if (!bl->pwm_bl) {
+		DSI_ERR("pwm device not found\n");
+		return -EINVAL;
+	}
+
+	period_ns = bl->pwm_period_usecs * NSEC_PER_USEC;
+	duty = bl_lvl * period_ns;
+	duty /= bl->bl_max_level;
+
+	rc = pwm_config(bl->pwm_bl, duty, period_ns);
+	if (rc) {
+		DSI_ERR("[%s] failed to change pwm config, rc=%d\n", panel->name,
+			rc);
+		goto error;
+	}
+
+	if (bl_lvl == 0 && bl->pwm_enabled) {
+		pwm_disable(bl->pwm_bl);
+		bl->pwm_enabled = false;
+		return 0;
+	}
+
+	if (bl_lvl != 0 && !bl->pwm_enabled) {
+		rc = pwm_enable(bl->pwm_bl);
+		if (rc) {
+			DSI_ERR("[%s] failed to enable pwm, rc=%d\n", panel->name,
+				rc);
+			goto error;
+		}
+
+		bl->pwm_enabled = true;
+	}
+
+error:
+	return rc;
+}
+
+int dsi_panel_set_backlight(struct dsi_panel *panel, u32 bl_lvl)
+{
+	int rc = 0;
+	struct dsi_backlight_config *bl = &panel->bl_config;
+#ifdef MI_DISPLAY_MODIFY
+        struct dsi_display *display = mi_get_primary_dsi_display();
+	if (strstr(display->name, "p19a virtual display")) {
+		DSI_INFO("is p19a_virtual, no setbl.\n");
+		return 0;
+	}
+#endif
+
+	if (panel->host_config.ext_bridge_mode)
+		return 0;
+
+#ifdef MI_DISPLAY_MODIFY
+	if (panel->mi_cfg.last_bl_level == 0 && bl_lvl){
+		mi_dsi_panel_state_count(panel, PANEL_POWERON_COST, 0);
+	}
+
+	if (is_backlight_set_skip(panel, bl_lvl)) {
+		mi_dsi_panel_update_last_bl_level(panel, bl_lvl);
+		return 0;
+	}
+
+	if (is_hbm_fod_on(panel)) {
+		if (bl_lvl == DEFAULT_DOZE_HBM_DBV_LEVEL) {
+			bl_lvl  = panel->mi_cfg.doze_hbm_dbv_level;
+		}
+		if (bl_lvl == DEFAULT_DOZE_lBM_DBV_LEVEL) {
+			bl_lvl = panel->mi_cfg.doze_lbm_dbv_level;
+		}
+		DSI_INFO("bl_lvl is %d, hbm fod  on\n", bl_lvl);
+	}
+	if (bl_lvl >= PEAK_HDR_BL_LEVEL && bl_lvl < MAX_BL_LEVEL && !panel->mi_cfg.is_peak_hdr) {
+		rc = dsi_panel_tx_cmd_set(panel, DSI_CMD_SET_MI_PEAK_MODE_ON);
+		panel->mi_cfg.is_peak_hdr = true;
+		DSI_INFO("bl_lvl is %d, peakhdr mode on\n", bl_lvl);
+	}
+
+	if (bl_lvl != 0 && bl_lvl < PEAK_HDR_BL_LEVEL && panel->mi_cfg.is_peak_hdr) {
+		rc = dsi_panel_tx_cmd_set(panel, DSI_CMD_SET_MI_PEAK_MODE_OFF);
+		panel->mi_cfg.is_peak_hdr = false;
+		DSI_INFO("bl_lvl is %d, peakhdr mode off\n", bl_lvl);
+	}
+
+#endif
+
+	if(bl_lvl == 0){
+		rc = dsi_panel_tx_cmd_set(panel, DSI_CMD_SET_MI_DIMMINGOFF);
+		usleep_range( 16 * 1000,  16 *1000 + 100);
+		DSI_INFO("dsi_panel_tx_cmd_set DSI_CMD_SET_MI_DIMMINGOFF = %d\n",rc);
+	}
+
+	DSI_INFO("backlight type:%d lvl:%d\n", bl->type, bl_lvl);
+	switch (bl->type) {
+	case DSI_BACKLIGHT_WLED:
+		rc = backlight_device_set_brightness(bl->raw_bd, bl_lvl);
+		break;
+	case DSI_BACKLIGHT_DCS:
+		rc = dsi_panel_update_backlight(panel, bl_lvl);
+		break;
+	case DSI_BACKLIGHT_EXTERNAL:
+		break;
+	case DSI_BACKLIGHT_PWM:
+		rc = dsi_panel_update_pwm_backlight(panel, bl_lvl);
+		break;
+	default:
+		DSI_ERR("Backlight type(%d) not supported\n", bl->type);
+		rc = -ENOTSUPP;
+	}
+#ifdef MI_DISPLAY_MODIFY
+	mi_dsi_panel_update_last_bl_level(panel, bl_lvl);
+#endif
+
+	return rc;
+}
+
+static u32 dsi_panel_get_brightness(struct dsi_backlight_config *bl)
+{
+	u32 cur_bl_level;
+	struct backlight_device *bd = bl->raw_bd;
+
+	/* default the brightness level to 50% */
+	cur_bl_level = bl->bl_max_level >> 1;
+
+	switch (bl->type) {
+	case DSI_BACKLIGHT_WLED:
+		/* Try to query the backlight level from the backlight device */
+		if (bd->ops && bd->ops->get_brightness)
+			cur_bl_level = bd->ops->get_brightness(bd);
+		break;
+	case DSI_BACKLIGHT_DCS:
+	case DSI_BACKLIGHT_EXTERNAL:
+	case DSI_BACKLIGHT_PWM:
+	default:
+		/*
+		 * Ideally, we should read the backlight level from the
+		 * panel. For now, just set it default value.
+		 */
+		break;
+	}
+
+	DSI_DEBUG("cur_bl_level=%d\n", cur_bl_level);
+	return cur_bl_level;
+}
+
+void dsi_panel_bl_handoff(struct dsi_panel *panel)
+{
+	struct dsi_backlight_config *bl = &panel->bl_config;
+
+	bl->bl_level = dsi_panel_get_brightness(bl);
+}
+
+static int dsi_panel_pwm_register(struct dsi_panel *panel)
+{
+	int rc = 0;
+	struct dsi_backlight_config *bl = &panel->bl_config;
+
+	bl->pwm_bl = devm_of_pwm_get(panel->parent, panel->panel_of_node, NULL);
+	if (IS_ERR_OR_NULL(bl->pwm_bl)) {
+		rc = PTR_ERR(bl->pwm_bl);
+		DSI_ERR("[%s] failed to request pwm, rc=%d\n", panel->name,
+			rc);
+		return rc;
+	}
+
+	if (panel->pinctrl.pwm_pin) {
+		rc = pinctrl_select_state(panel->pinctrl.pinctrl,
+			panel->pinctrl.pwm_pin);
+		if (rc)
+			DSI_ERR("[%s] failed to set pwm pinctrl, rc=%d\n",
+				panel->name, rc);
+	}
+
+	return 0;
+}
+
+static int dsi_panel_bl_register(struct dsi_panel *panel)
+{
+	int rc = 0;
+	struct dsi_backlight_config *bl = &panel->bl_config;
+
+	if (panel->host_config.ext_bridge_mode)
+		return 0;
+
+	switch (bl->type) {
+	case DSI_BACKLIGHT_WLED:
+		rc = dsi_panel_wled_register(panel, bl);
+		break;
+	case DSI_BACKLIGHT_DCS:
+		break;
+	case DSI_BACKLIGHT_EXTERNAL:
+		break;
+	case DSI_BACKLIGHT_PWM:
+		rc = dsi_panel_pwm_register(panel);
+		break;
+	default:
+		DSI_ERR("Backlight type(%d) not supported\n", bl->type);
+		rc = -ENOTSUPP;
+		goto error;
+	}
+
+error:
+	return rc;
+}
+
+static int dsi_panel_bl_unregister(struct dsi_panel *panel)
+{
+	int rc = 0;
+	struct dsi_backlight_config *bl = &panel->bl_config;
+
+	if (panel->host_config.ext_bridge_mode)
+		return 0;
+
+	switch (bl->type) {
+	case DSI_BACKLIGHT_WLED:
+		break;
+	case DSI_BACKLIGHT_DCS:
+		break;
+	case DSI_BACKLIGHT_EXTERNAL:
+		break;
+	case DSI_BACKLIGHT_PWM:
+		break;
+	default:
+		DSI_ERR("Backlight type(%d) not supported\n", bl->type);
+		rc = -ENOTSUPP;
+		goto error;
+	}
+
+error:
+	return rc;
+}
