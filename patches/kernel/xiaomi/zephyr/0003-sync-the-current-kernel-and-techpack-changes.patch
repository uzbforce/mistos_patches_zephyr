+static int mi_disp_debugfs_fod_test_show(struct seq_file *m, void *data)
+{
+	seq_printf(m, "parameter: %s\n", "<down_sleep_ms> <up_sleep_ms> <retry_count>");
+	seq_printf(m, "for example: %s\n", "echo 50 50 100 > /d/mi_display/fod_test");
+	seq_printf(m, "\n");
+
+	return 0;
+}
