@@ -0,0 +1,21 @@
+#ifndef _MI_DISP_FLAT_MODE_H_
+#define _MI_DISP_FLAT_MODE_H_
+
+#include "dsi_parser.h"
+#include "dsi_panel.h"
+#include "dsi_display.h"
