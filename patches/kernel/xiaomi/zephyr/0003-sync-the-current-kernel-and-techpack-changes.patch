+static int ad4_init_setup_ipcr(struct sde_hw_dspp *dspp,
+		struct sde_ad_hw_cfg *cfg)
+{
+	int ret;
+	u32 blk_offset;
+
+	if (!cfg->hw_cfg->payload) {
