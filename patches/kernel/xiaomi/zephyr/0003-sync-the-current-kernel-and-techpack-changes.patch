+
+#define NEED_UPDATE_TO_FOD_FPS 120
+
+enum {
+	FOD_EVENT_UP = 0,
+	FOD_EVENT_DOWN = 1,
+	FOD_EVENT_FPS = 2,
+	FOD_EVENT_MAX
+};
+
+enum mi_panel_op_code {
+	MI_FOD_HBM_ON = 0,
+	MI_FOD_HBM_OFF,
+	MI_FOD_AOD_TO_NORMAL,
+	MI_FOD_NORMAL_TO_AOD,
