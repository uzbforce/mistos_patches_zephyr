+	SDEDEV_DBG(rot_dev->dev,
+		"s_fmt s:%d t:%d fmt:0x%8.8x field:%u (%u,%u)\n",
+		ctx->session_id, f->type,
+		f->fmt.pix.pixelformat,
+		f->fmt.pix.field,
+		f->fmt.pix.width, f->fmt.pix.height);
