+#define REG_DMA_INIT_OPS(cfg, block, reg_dma_feature, feature_dma_buf) \
+	do { \
+		memset(&cfg, 0, sizeof(cfg)); \
+		(cfg).blk = block; \
+		(cfg).feature = reg_dma_feature; \
+		(cfg).dma_buf = feature_dma_buf; \
+	} while (0)
