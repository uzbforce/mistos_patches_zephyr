+					NOISE_LAYER_OFF, 0);
+		sblk->nlayer.version = PROP_VALUE_ACCESS(props->values,
+					NOISE_LAYER_VERSION, 0);
+		sblk->nlayer.len = sizeof(u32);
+		set_bit(SDE_MIXER_NOISE_LAYER, &lm->features);
+	}
+exit:
+	sde_put_dt_props(props);
+	return 0;
+}
