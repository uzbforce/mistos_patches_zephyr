+static int _sde_debugfs_init(struct sde_kms *sde_kms)
+{
+	void *p;
+	int rc;
+	void *debugfs_root;
+
+	p = sde_hw_util_get_log_mask_ptr();
+
+	if (!sde_kms || !p)
+		return -EINVAL;
