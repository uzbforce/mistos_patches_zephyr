+	sde_kms_info_add_keyint(info, "max_blendstages", shd_display->stage_range.size);
+
+	sde_kms_info_add_keystr(info, "display type", shd_display->display_type);
+
+	sde_kms_info_add_keystr(info, "display type", shd_display->display_type);
