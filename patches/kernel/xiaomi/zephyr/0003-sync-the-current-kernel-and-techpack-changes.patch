+	rc = _validate_dt_entry(np, merge_3d_prop, ARRAY_SIZE(merge_3d_prop),
+		prop_count, &off_count);
+	if (rc)
+		goto end;
+
+	sde_cfg->merge_3d_count = off_count;
+
+	rc = _read_dt_entry(np, merge_3d_prop, ARRAY_SIZE(merge_3d_prop),
