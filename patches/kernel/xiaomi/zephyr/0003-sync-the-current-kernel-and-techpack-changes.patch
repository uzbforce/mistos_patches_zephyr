+	void (*setup_ltm_roi)(struct sde_hw_dspp *ctx, void *cfg);
+
+	/**
+	 * setup_ltm_vlut - setup LTM VLUT
+	 * @ctx: Pointer to dspp context
+	 * @cfg: Pointer to configuration
+	 */
