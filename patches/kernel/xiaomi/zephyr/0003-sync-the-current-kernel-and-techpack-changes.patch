+static inline bool _is_dspp_flush_pending(struct sde_hw_ctl *ctx)
+{
+	int i;
+
+	for (i = 0; i < CTL_MAX_DSPP_COUNT; i++) {
+		if (ctx->flush.pending_dspp_flush_masks[i])
+			return true;
+	}
+
+	return false;
+}
