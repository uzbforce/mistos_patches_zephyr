+++ b/arch/arm64/configs/vendor/zephyr_GKI.config
@@ -358,7 +358,6 @@ CONFIG_TMS_NFC_DEVICE=m
 CONFIG_TMS_ESE_DEVICE=n
 CONFIG_TMS_GUIDE_DEVICE=m
 # add radio cable detection
-CONFIG_RFCABLE_DETECT=m
 # add radio cable detection end
 
 # add i2c_dump
