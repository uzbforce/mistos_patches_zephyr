index 000000000..50da7ca9a
--- /dev/null
+++ b/techpack/display/msm/dp/dp_link.h
@@ -0,0 +1,246 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copyright (c) 2012-2021, The Linux Foundation. All rights reserved.
