+	if (c_conn->ops.config_hdr)
+		rc = c_conn->ops.config_hdr(&c_conn->base, c_conn->display,
+				c_state);
+
+	if (rc)
+		SDE_ERROR_CONN(c_conn, "cannot apply hdr metadata %d\n", rc);
+
+	SDE_DEBUG_CONN(c_conn, "updated hdr metadata: %d\n", rc);
