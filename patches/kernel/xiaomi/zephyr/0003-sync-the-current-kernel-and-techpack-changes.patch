+#define DSIPHY_CMN_GLBL_PEMPH_CTRL_0					0x104
+#define DSIPHY_CMN_GLBL_PEMPH_CTRL_1					0x108
+#define DSIPHY_CMN_GLBL_STR_SWI_CAL_SEL_CTRL				0x10C
