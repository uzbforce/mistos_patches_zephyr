+int dsi_panel_parse_cell_id_read_config(struct dsi_panel *panel)
+{
+	struct drm_panel_cell_id_config *cell_id_config;
+	struct dsi_parser_utils *utils = &panel->utils;
+	int rc = 0;
+
+	if (!panel) {
+		DISP_ERROR("Invalid Params\n");
