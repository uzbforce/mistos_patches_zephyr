+static int dsi_panel_power_on_config(struct dsi_panel *panel)
+{
+	int rc = 0;
+	struct dsi_panel_power_config *p_config = &panel->power_config;
+
+	if (!p_config) {
+		DSI_ERR("p_config is null, cannot set power on!\n");
+		return -EINVAL;
+	}
+
+	usleep_range(1 * 1000, (1 * 1000) + 100);
+
+	if (gpio_is_valid(p_config->dvdd_gpio)) {
+		rc = gpio_direction_output(p_config->dvdd_gpio, 1);
+		if (rc) {
+			DSI_ERR("unable to set dir for disp gpio rc=%d\n", rc);
+			goto exit;
+		}
+		gpio_set_value(p_config->dvdd_gpio, 1);
+	}
+
+	usleep_range(2 * 1000, (2 * 1000) + 100);
+
+	if (gpio_is_valid(p_config->vci_gpio)) {
+		rc = gpio_direction_output(p_config->vci_gpio, 1);
+		if (rc) {
+			DSI_ERR("unable to set dir for disp gpio rc=%d\n", rc);
+			goto exit;
+		}
+		gpio_set_value(p_config->vci_gpio, 1);
+	}
+
+	usleep_range(2 * 1000, (2 * 1000) + 100);
+
+exit:
+	return rc;
+}
