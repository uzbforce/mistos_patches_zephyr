+	}
+
+	/* Allocate transform for AES CRYPTO_ALG_TYPE_BLKCIPHER */
+	info_manager->tfm = crypto_alloc_cipher("aes",
+			CRYPTO_ALG_TYPE_BLKCIPHER, CRYPTO_ALG_ASYNC);
