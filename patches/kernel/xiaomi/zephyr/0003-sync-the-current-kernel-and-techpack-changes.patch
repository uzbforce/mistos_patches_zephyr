+static void _dsi_display_setup_misr(struct dsi_display *display)
+{
+	int i;
+
+	display_for_each_ctrl(i, display) {
+		dsi_ctrl_setup_misr(display->ctrl[i].ctrl,
+				display->misr_enable,
+				display->misr_frame_count);
+	}
+}
+
+int dsi_display_set_power(struct drm_connector *connector,
+		int power_mode, void *disp)
+{
+	struct dsi_display *display = disp;
+	int rc = 0;
+
+	if (!display || !display->panel) {
+		DSI_ERR("invalid display/panel\n");
+		return -EINVAL;
+	}
+
+#ifdef MI_DISPLAY_MODIFY
+	mutex_lock(&display->panel->mi_cfg.doze_lock);
+	DISP_TIME_INFO("Display (%s), Power mode (%s)\n", display->display_type,
+					get_display_power_mode_name(power_mode));
+#endif
+
+	switch (power_mode) {
+	case SDE_MODE_DPMS_LP1:
+		if (display->panel->power_mode == SDE_MODE_DPMS_LP2) {
+			if (dsi_display_set_ulp_load(display, false) < 0)
+				DSI_WARN("failed to set load for lp1 state\n");
+		}
+
+#ifdef MI_DISPLAY_MODIFY
+		display->panel->power_mode = power_mode;
+#endif
+		rc = dsi_panel_set_lp1(display->panel);
+		rc = dsi_panel_tx_cmd_set(display->panel, DSI_CMD_SET_MI_DIMMINGOFF);
+		DSI_INFO("dsi_panel_tx_cmd_set DSI_CMD_SET_MI_DIMMINGOFF = %d\n",rc);
+		break;
+	case SDE_MODE_DPMS_LP2:
+#ifdef MI_DISPLAY_MODIFY
+		display->panel->power_mode = power_mode;
+#endif
+		rc = dsi_panel_set_lp2(display->panel);
+		if (dsi_display_set_ulp_load(display, true) < 0)
+			DSI_WARN("failed to set load for lp2 state\n");
+		break;
+	case SDE_MODE_DPMS_ON:
+		if (display->panel->power_mode == SDE_MODE_DPMS_LP2) {
+			if (dsi_display_set_ulp_load(display, false) < 0)
+				DSI_WARN("failed to set load for on state\n");
+		}
+		if ((display->panel->power_mode == SDE_MODE_DPMS_LP1) ||
+			(display->panel->power_mode == SDE_MODE_DPMS_LP2))
+			rc = dsi_panel_set_nolp(display->panel);
+#ifdef MI_DISPLAY_MODIFY
+			if(!rc){
+				if (ESD_TYPE != 0) {
+					DSI_INFO("[%d] recovery done\n", ESD_TYPE);
+					mi_disp_mievent_recovery(ESD_TYPE);
+				}
+			}
+#endif
+		break;
+	case SDE_MODE_DPMS_OFF:
+#ifdef MI_DISPLAY_MODIFY
+
+		if (mi_disp_lhbm_fod_enabled(display->panel))
+			mi_disp_lhbm_fod_allow_tx_lhbm(display, false);
+		mi_disp_feature_event_notify_by_type(mi_get_disp_id(display->display_type),
+				MI_DISP_EVENT_POWER, sizeof(power_mode), power_mode);
+#endif
+	default:
+#ifdef MI_DISPLAY_MODIFY
+		mutex_unlock(&display->panel->mi_cfg.doze_lock);
+#endif
+		return rc;
+	}
+
+	SDE_EVT32(display->panel->power_mode, power_mode, rc);
+	DSI_DEBUG("Power mode transition from %d to %d %s",
+			display->panel->power_mode, power_mode,
+			rc ? "failed" : "successful");
+#ifdef MI_DISPLAY_MODIFY
+	if (!rc) {
+		if (power_mode == SDE_MODE_DPMS_ON && ESD_TYPE != 0) {
+			DSI_INFO("[%d] recovery done\n", ESD_TYPE);
+			mi_disp_mievent_recovery(ESD_TYPE);
+		}
+		display->panel->power_mode = power_mode;
+
+		mi_disp_feature_event_notify_by_type(mi_get_disp_id(display->display_type),
+				MI_DISP_EVENT_POWER, sizeof(power_mode), power_mode);
+	}
+	mutex_unlock(&display->panel->mi_cfg.doze_lock);
+#else
+	if (!rc)
+			display->panel->power_mode = power_mode;
+#endif
+
+	return rc;
+}
