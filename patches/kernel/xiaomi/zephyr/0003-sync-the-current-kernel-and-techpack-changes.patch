+		goto bail;
+
+	DP_DEBUG("tpg_pattern: %d\n", tpg_pattern);
+
+	if (tpg_pattern == debug->dp_debug.tpg_pattern)
+		goto bail;
+
+	if (debug->panel)
+		debug->panel->tpg_config(debug->panel, tpg_pattern);
+
+	debug->dp_debug.tpg_pattern = tpg_pattern;
+bail:
+	return len;
+}
