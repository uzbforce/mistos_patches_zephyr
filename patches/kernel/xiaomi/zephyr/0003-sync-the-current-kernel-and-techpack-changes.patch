+static void sde_fence_destroy(struct kref *kref)
+{
+	struct sde_fence_context *ctx;
+
+	if (!kref) {
+		SDE_ERROR("received invalid kref\n");
+		return;
+	}
+
+	ctx = container_of(kref, struct sde_fence_context, kref);
+	kfree(ctx);
+}
