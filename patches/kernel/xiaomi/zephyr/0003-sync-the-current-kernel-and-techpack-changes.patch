+	if (!dsi_display) {
+		DISP_ERROR("Invalid display ptr\n");
+		return -EINVAL;
+	}
+
+	switch (DFS_case) {
+		case MI_EVENT_PRI_PANEL_REG_ESD: {
+			mi_event.event_type = MI_EVENT_PRI_PANEL_REG_ESD;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_PRI_PANEL_IRQ_ESD: {
+			mi_event.event_type = MI_EVENT_PRI_PANEL_IRQ_ESD;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_PRI_PLATFORM_ESD:{
+			mi_event.event_type = MI_EVENT_PRI_PLATFORM_ESD;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_DSI_ERROR:{
+			mi_disp_mievent_str(MI_EVENT_DSI_ERROR);
+		}
+		break;
+		case MI_EVENT_PANEL_HW_RESOURCE_GET_FAILED:{
+			mi_disp_mievent_str(MI_EVENT_PANEL_HW_RESOURCE_GET_FAILED);
+		}
+		break;
+		case MI_EVENT_PANEL_RECOGNIZE_ERR:{
+			mi_disp_mievent_str(MI_EVENT_PANEL_RECOGNIZE_ERR);
+		}
+		break;
+		case MI_EVENT_PANEL_WP_READ_FAILED:{
+			mi_disp_mievent_str(MI_EVENT_PANEL_WP_READ_FAILED);
+		}
+		break;
+		case MI_EVENT_PANEL_UNDERRUN:{
+			mi_event.event_type = MI_EVENT_PANEL_UNDERRUN;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_ALL_ZERO_PCC:{
+			mi_event.event_type = MI_EVENT_ALL_ZERO_PCC;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_INVALID_FRAME_PENDING:{
+			mi_event.event_type = MI_EVENT_INVALID_FRAME_PENDING;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_CMD_RECEIVE_FAILED:{
+			mi_event.event_type = MI_EVENT_CMD_RECEIVE_FAILED;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_CMD_SEND_FAILED:{
+			mi_event.event_type = MI_EVENT_CMD_SEND_FAILED;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_SMMU_FAULT:{
+			mi_event.event_type = MI_EVENT_SMMU_FAULT;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_FENCE_SIGNAL_ERR:{
+			mi_event.event_type = MI_EVENT_FENCE_SIGNAL_ERR;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_CLOCK_ERR:{
+			mi_event.event_type = MI_EVENT_CLOCK_ERR;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_DMA_BUF_ALLOCATE_FAILED:{
+			mi_event.event_type = MI_EVENT_DMA_BUF_ALLOCATE_FAILED;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_PANEL_HARDWARE_ERR:{
+			mi_disp_mievent_str(MI_EVENT_PANEL_WP_READ_FAILED);
+		}
+		break;
+		case MI_EVENT_PINGPONG_TIMEOUT:{
+			mi_event.event_type = MI_EVENT_PINGPONG_TIMEOUT;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
+		}
+		break;
+		case MI_EVENT_DMA_CMD_TIMEOUT:{
+			mi_event.event_type = MI_EVENT_DMA_CMD_TIMEOUT;
+			mi_disp_mievent_int(MI_DISP_PRIMARY,&mi_event);
