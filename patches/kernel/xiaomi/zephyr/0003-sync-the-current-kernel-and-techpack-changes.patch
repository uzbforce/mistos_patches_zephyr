+
+extern char whitepoint_info_s[];
+extern char lcd_name[];
+static ssize_t wp_info_show(struct device *device,
+			struct device_attribute *attr, char *buf)
+{
+	ssize_t ret = -EINVAL;
+	int index=0;
+	char data[4]={0x00,0x00, 0x00, 0x00};
+	int whitepoint_x=320;
+	int whitepoint_y=320;
+	data[0]=whitepoint_info_s[index]; ++index;
+	data[1]=whitepoint_info_s[index]; ++index;
+	data[2]=whitepoint_info_s[index]; ++index;
+	data[3]=whitepoint_info_s[index]; ++index;
+	sscanf(data,"%04x",&whitepoint_x);
+
+	data[0]=whitepoint_info_s[index]; ++index;
+	data[1]=whitepoint_info_s[index]; ++index;
+	data[2]=whitepoint_info_s[index]; ++index;
+	data[3]=whitepoint_info_s[index]; ++index;
+	sscanf(data,"%04x",&whitepoint_y);
+
+    DSI_INFO("origin read:%04x,%04x\n",whitepoint_x,whitepoint_y);
+
+	//whitepoint_x=300+whitepoint_x-0x80;
