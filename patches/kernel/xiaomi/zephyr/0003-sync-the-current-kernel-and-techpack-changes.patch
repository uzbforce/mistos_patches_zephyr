+
+	display_for_each_ctrl(i, display) {
+		ctrl = &display->ctrl[i];
+		rc = dsi_ctrl_phy_reset_config(ctrl->ctrl, enable);
+		if (rc) {
+			DSI_ERR("[%s] failed to %s phy reset, rc=%d\n",
+			       display->name, enable ? "mask" : "unmask", rc);
+			return rc;
+		}
+	}
