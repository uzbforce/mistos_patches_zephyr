+#define DSIPHY_CMN_CTRL_0						0x024
+#define DSIPHY_CMN_CTRL_1						0x028
+#define DSIPHY_CMN_CTRL_2						0x02C
+#define DSIPHY_CMN_CTRL_3						0x030
