+static ssize_t state_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	size_t len = PAGE_SIZE;
+	int cnt = 0;
+	struct sde_rot_mgr *mgr = sde_rot_mgr_from_device(dev);
+	int i;
+
+	if (!mgr)
+		return cnt;
+
+#define SPRINT(fmt, ...) \
+		(cnt += scnprintf(buf + cnt, len - cnt, fmt, ##__VA_ARGS__))
