+static int sde_hw_intf_poll_timeout_wr_ptr(struct sde_hw_intf *intf,
+		u32 timeout_us)
+{
+	struct sde_hw_blk_reg_map *c;
+	u32 val;
+
+	if (!intf)
+		return -EINVAL;
+
+	c = &intf->hw;
+	return read_poll_timeout(sde_reg_read, val, (val & 0xffff) >= 1, 10, false, timeout_us,
+			c, INTF_TEAR_LINE_COUNT);
+}
