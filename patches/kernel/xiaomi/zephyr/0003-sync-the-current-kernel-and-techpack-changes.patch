From: uzbforce <oktamovazizbek2010@gmail.com>
Subject: [kernel/xiaomi/zephyr] sync the current kernel and techpack changes

diff --git a/Makefile b/Makefile
index dc5940535..8534bc6f3 100644
--- a/Makefile
+++ b/Makefile
@@ -695,7 +695,7 @@ endif
 
 ifeq ($(KBUILD_EXTMOD),)
 # Objects we will link into vmlinux / subdirs we need to visit
-core-y		:= init/ usr/ arch/$(SRCARCH)/
+core-y		:= init/ usr/ arch/$(SRCARCH)/ techpack/
 drivers-y	:= drivers/ sound/
 drivers-$(CONFIG_SAMPLES) += samples/
 drivers-$(CONFIG_NET) += net/
@@ -2116,3 +2116,10 @@ FORCE:
 # Declare the contents of the PHONY variable as phony.  We keep that
 # information in a variable so we can use it in if_changed and friends.
 .PHONY: $(PHONY)
+
+# ZEPHYR_VENDOR_WARNINGS: clang 21 promotes these to errors by default, and the
+# Xiaomi vendor drivers in this tree (minidump, lx_chg, zram changes) predate
+# that. Keep them as warnings so the vendor code builds unmodified.
+KBUILD_CFLAGS += -Wno-implicit-int -Wno-implicit-function-declaration \
+                 -Wno-strict-prototypes -Wno-missing-prototypes \
+                 -Wno-deprecated-non-prototype -Wno-int-conversion
