 #KSHRINK_SLABD
 CONFIG_KSHRINK_SLABD=m
+CONFIG_DRM=m
+CONFIG_DRM_MSM=m
+CONFIG_DRM_MSM_DSI=y
+# Bengal has no DisplayPort: the display driver's own gki_bengaldisp.conf
+# exports CONFIG_DRM_MSM_DP=n, so the dp/ objects are never linked. Leaving the
+# kernel config at =y made msm_drv.c call the real dp_display_register() and
+# the module failed to link with ten undefined dp_* symbols. Keep both halves
+# off so msm_drv.h's inline stubs are used.
+# CONFIG_DRM_MSM_DP is not set
+CONFIG_ANDROID_VENDOR_HOOKS=y
+CONFIG_THERMAL=y
+CONFIG_FRAME_WARN=4096
+# CONFIG_WERROR is not set
