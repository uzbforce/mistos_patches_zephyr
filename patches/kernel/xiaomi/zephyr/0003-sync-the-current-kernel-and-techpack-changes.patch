+	if (!crtc)
+		return -EINVAL;
+
+	sde_crtc = to_sde_crtc(crtc);
+
+	return scnprintf(buf, PAGE_SIZE, "%d\n",
+		(sde_crtc->fps_info.fps_periodic_duration)/MILI_TO_MICRO);
+}
