+	uint32_t csc_post_bv[SDE_CSC_BIAS_SIZE];
+	uint32_t csc_pre_lv[SDE_CSC_CLAMP_SIZE];
+	uint32_t csc_post_lv[SDE_CSC_CLAMP_SIZE];
+};
