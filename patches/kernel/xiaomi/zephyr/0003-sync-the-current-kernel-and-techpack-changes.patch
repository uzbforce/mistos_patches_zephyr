+		SDE_EVT32((blk->rsvp) ? blk->rsvp->seq : 0,
+			(blk->rsvp) ? blk->rsvp->enc_id : 0,
+			(blk->rsvp_nxt) ? blk->rsvp_nxt->seq : 0,
