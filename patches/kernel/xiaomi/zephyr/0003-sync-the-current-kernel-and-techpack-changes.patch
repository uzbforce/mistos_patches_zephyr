+		_sde_cp_crtc_install_range_property(crtc, "SDE_DSPP_AD_V4_CFG",
+			SDE_CP_CRTC_DSPP_AD_CFG, 0, U64_MAX, 0);
+		_sde_cp_create_local_blob(crtc, SDE_CP_CRTC_DSPP_AD_CFG,
