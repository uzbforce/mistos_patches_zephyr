+	DSI_CMD_SET_RES_SWITCH,
+	DSI_CMD_SET_POST_RES_SWITCH,
+	DSI_CMD_SET_VID_SWITCH_IN,
+	DSI_CMD_SET_VID_SWITCH_OUT,
+	DSI_CMD_SET_CMD_SWITCH_IN,
+	DSI_CMD_SET_CMD_SWITCH_OUT,
