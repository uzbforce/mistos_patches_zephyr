+#define DSIPHY_CMN_TIMING_CTRL_11					0x0E0
+#define DSIPHY_CMN_TIMING_CTRL_12					0x0E4
+#define DSIPHY_CMN_TIMING_CTRL_13					0x0E8
+#define DSIPHY_CMN_GLBL_HSTX_STR_CTRL_0					0x0EC
