+#define MMSS_DP1_INTF_VSYNC_PULSE_WIDTH_F1	(0x00000028)
+#define MMSS_DP1_INTF_DISPLAY_V_START_F0	(0x0000002C)
+#define MMSS_DP1_INTF_DISPLAY_V_START_F1	(0x00000030)
