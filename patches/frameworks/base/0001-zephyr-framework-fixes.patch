+    /**
+     * The vendor registers many of its custom sensors twice, once non-wakeup and once
+     * wakeup, under the same string type. The UDFPS trigger must use the wakeup variant:
+     * the non-wakeup one is suspended with the AP and cannot start authentication while
+     * the display is off.
+     */
+    private Sensor findUdfpsSensor(String type) {
+        Sensor fallback = null;
+        for (Sensor sensor : mSensorManager.getSensorList(Sensor.TYPE_ALL)) {
+            if (type.equals(sensor.getStringType())) {
+                if (sensor.isWakeUpSensor()) {
+                    return sensor;
+                }
+                if (fallback == null) {
+                    fallback = sensor;
+                }
+            }
+        }
+        return fallback;
+    }
